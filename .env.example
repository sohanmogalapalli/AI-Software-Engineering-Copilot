# LLM Provider & Fast Cloud Inference
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3-flash-preview

# Cloud API Keys (Paste your key here or configure directly in the UI Settings)
# Get a free Google Gemini key in 30s: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Get a free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# xAI Grok API key: https://console.x.ai/
GROK_API_KEY=

# Ollama Local Service Configuration (Fallback)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text:latest

# Storage Paths
VECTOR_STORE_PATH=data/vector_store
REPOSITORY_PATH=data/repositories
CHUNK_PATH=data/chunks
INDEX_PATH=data/indexes

# Retrieval Configuration
TOP_K=8
SIMILARITY_THRESHOLD=0.25
RRF_K=60

# Server Configuration
HOST=127.0.0.1
PORT=8000
